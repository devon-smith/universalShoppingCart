# apps/extension — copy to .env for local development.
#
# WXT inlines WXT_PUBLIC_* into the extension bundle, which anyone who installs the
# extension can read. Only client-safe values belong here. A Supabase service-role key
# or an OAuth client secret in this file is a security incident (BUILD_PLAN.md §17.2).

WXT_PUBLIC_APP_URL=http://localhost:3000

# Populated in Phase 1, when extension auth lands. `pnpm supabase:start` prints both.
WXT_PUBLIC_SUPABASE_URL=
WXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
