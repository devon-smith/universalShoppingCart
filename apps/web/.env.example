# apps/web — copy to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never give a secret a
# NEXT_PUBLIC_ prefix (BUILD_PLAN.md §17.2).

# --- Client-safe ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Populated in Phase 1, when Supabase auth lands. `pnpm supabase:start` prints both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only: never expose to the browser or the extension ---
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
AI_PROVIDER_API_KEY=
