# Universal Cart — environment variable inventory.
#
# This file documents ownership and safety class. It contains no secrets and is the
# only .env* file committed to the repository. Per-workspace examples live at
# apps/web/.env.example and apps/extension/.env.example.
#
# Safety classes (BUILD_PLAN.md §17.2):
#   client-safe  — may appear in a browser or extension bundle
#   server-only  — may only be read by the Next.js server runtime or a job runner
#
# Never give a server-only value a NEXT_PUBLIC_ or WXT_PUBLIC_ prefix.

# ---------------------------------------------------------------------------
# apps/web (client-safe)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# apps/web (server-only)
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
AI_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# apps/extension (client-safe, inlined at build time)
# ---------------------------------------------------------------------------
WXT_PUBLIC_APP_URL=http://localhost:3000
WXT_PUBLIC_SUPABASE_URL=
WXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase project configuration (server-only; read by the Supabase CLI, never
# by application code). Only needed to exercise Google sign-in against the local
# stack — see [auth.external.google] in supabase/config.toml.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
